# ---------------------------------------------------------------------------
# Database — Supabase Postgres (always-free tier, no 30-day expiry).
# Supabase dashboard → Project Settings → Database → Connection string.
# Use the *Transaction pooler* string (port 6543): it is reachable over IPv4,
# which Render's free tier requires, and it pools connections for a small
# instance. Keep `sslmode=require`; db.ts enables TLS for any non-localhost
# host anyway.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-too-another-long-random-string"
# Encrypts TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it invalidates every enrolled authenticator app.
ENCRYPTION_KEY="change-me-32-bytes-base64"

PORT=4000
CORS_ORIGIN="http://localhost:5000"
NODE_ENV=development

# A quote older than this halts trading on that symbol: nothing opens, closes,
# fills or liquidates against a price the market has left behind. Default is
# 120000 (two minutes). Working offline, with no route to Binance/CoinGecko,
# nothing refreshes the seeded prices and the whole board halts after two
# minutes — raise this locally (e.g. a day) if you need to keep trading against
# seeded quotes. Never raise it in production: it is the only thing stopping a
# liquidation at a price that never happened.
MAX_QUOTE_AGE_MS=120000

# How long the upstream price feed must be failing before the outage is
# escalated from a log line to an alert. Default 60000.
FEED_UNHEALTHY_ALERT_MS=60000

# ---------------------------------------------------------------------------
# Optional integrations. Every one of these is safe to leave empty: the
# feature it powers degrades to a documented no-op instead of failing.
# ---------------------------------------------------------------------------

# Error reporting (Sentry free tier). Empty = errors only go to the log.
SENTRY_DSN=""

# KYC document storage. Documents and selfies go to a *private* Supabase
# Storage bucket and are only ever read back through short-lived signed URLs.
# The service-role key is server-only — it must never reach the browser.
# Empty = KYC submission is rejected with a clear "storage not configured".
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_KYC_BUCKET="kyc-documents"

# Transactional email (Resend free tier) for email verification and password
# reset. Empty = the message is written to the server log instead of sent,
# which is what you want in local development.
RESEND_API_KEY=""
MAIL_FROM="Velora <no-reply@velora.local>"
# Base URL the links in those emails point at (the frontend, not the API).
PUBLIC_APP_URL="http://localhost:5000"
